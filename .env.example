# Supabase Configuration (Optional - App falls back to LocalStorage automatically if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Pluggy Open Finance Brasil SDK Configuration (Optional - Server-only, NEVER commit .env.local)
PLUGGY_CLIENT_ID=your-pluggy-client-id
PLUGGY_CLIENT_SECRET=your-pluggy-client-secret
PLUGGY_API_KEY=your-pluggy-api-key
PLUGGY_ITEM_ID=your-optional-default-pluggy-item-id

# Optional Secret for Real-Time Mobile Push Notification Webhook (/api/webhook/notification)
KASHI_WEBHOOK_SECRET=your-optional-webhook-secret
