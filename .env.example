# Supabase Configuration (Single-Owner Encrypted PostgreSQL + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Single-Owner Email Lock (Optional — restricts login exclusively to your email)
NEXT_PUBLIC_OWNER_EMAIL=your-owner-email@example.com

# Pluggy Open Finance Brasil Personal Credentials (Server-only, NEVER commit .env.local)
PLUGGY_CLIENT_ID=your-pluggy-client-id
PLUGGY_CLIENT_SECRET=your-pluggy-client-secret

# Optional Secret for Real-Time Mobile Push Notification Webhook (/api/webhook/notification)
KASHI_WEBHOOK_SECRET=your-optional-webhook-secret
